params {
    input     = 'genomes/*.faa'

    media_databases	= [
		NO_GAPFILL: null,
		'SDMM' : "${projectDir}/assets/SDMM_media.tsv",
		'M9' : null
	]

    outdir    = "results"
    solver	= "scip"
    universe = null
    universe_file = null
    carveme_args = ''

    carveme_container = projectDir
        .resolve('containers/carveme-1.6.6.sif')
        .toString()
    
    run_cobra = false

    /* COBRApy execution */
    cobra_container = projectDir
        .resolve('containers/cobra-analysis.sif')
        .toString()
    
    cobra_method = 'pfba'
    cobra_fraction_of_optimum = 1.0
    cobra_objective = null
    cobra_solver = null
    cobra_medium = null
    cobra_medium_mode = 'replace'
    cobra_ignore_missing_medium_reactions = false
    cobra_flux_threshold = 1e-9
    cobra_fail_on_nonoptimal = true
    cobra_run_args = null

    /* Aggregated tables and heat maps */
    cobra_outputs = [
        'growth-table',
        'summary-long',
        'summary-matrix',
        'summary-heatmap'
    ]
    cobra_row_columns = ['sample_id', 'medium']
    cobra_row_separator = ' | '
    cobra_summary_column = 'metabolite'
    cobra_summary_boundary_types = ['exchange']
    cobra_min_abs_flux = 1e-9
    cobra_top_n = 50
    cobra_heatmap_transform = 'signed-log1p'
    cobra_figure_format = 'png'
    cobra_dpi = 300
    cobra_include_nonoptimal = false
    cobra_summary_args = null
    bigg_metabolites = null
}

process {

    withName: /RUN_CARVEME_.*/ {
        container = params.carveme_container
        cpus      = 1
        memory    = '8 GB'
        time      = '12h'

        publishDir = [
            [
                path   : { "${params.outdir}/models" },
                mode   : 'symlink',
                pattern: '*.sbml'
            ],
            [
                path   : { "${params.outdir}/logs" },
                mode   : 'symlink',
                pattern: '*.log'
            ]
        ]
    }

    withName: RUN_COBRA_MODEL {
        container = params.cobra_container
        cpus = 1
        memory = 4.GB
        time = 2.h
        publishDir = [
            path: "${params.outdir}/cobra/per_model",
            mode: 'copy',
            overwrite: true,
            pattern: '*.tsv'
        ]
    }

    withName: SUMMARIZE_COBRA_MODELS {
        container = params.cobra_container
        cpus = 1
        memory = 8.GB
        time = 2.h
        publishDir = [
            path: "${params.outdir}/cobra",
            mode: 'copy',
            overwrite: true,
            pattern: 'comparison'
        ]
    }
}

profiles {

    apptainer {
        apptainer {
            enabled     = true
            autoMounts  = true
            pullTimeout = '60 min'
        }
    }

    singularity {
        singularity {
            enabled     = true
            autoMounts  = true
            pullTimeout = '60 min'
        }
    }
}

timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/timeline.html"
}

report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/report.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/trace.tsv"
}

dag {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/dag.html"
}
